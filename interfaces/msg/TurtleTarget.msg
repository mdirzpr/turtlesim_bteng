# Represents a single prey turtle spawned by the turtle_spawner node.
# Published on /new_turtle whenever a new prey turtle is created.
string name   # ROS name of the turtle (e.g. "prey_1")
float32 x     # X position in turtlesim canvas [0.0, 11.0]
float32 y     # Y position in turtlesim canvas [0.0, 11.0]
